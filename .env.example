HOLO_BASE_URL=https://your-vision-endpoint/v1
HOLO_MODEL=holo
HOLO_API_KEY=
HOLO_MAX_TOKENS=2048
HOLO_TIMEOUT=120
HOLO_COORDINATE_SPACE=normalized
DESKTOP_SIZE=1920x1080
UIAUTO_HOST=carla
# Optional model-neutral actor configuration; overrides HOLO_* when BASE_URL is set.
# UIAUTO_MODEL_BASE_URL=https://your-vision-endpoint/v1
# UIAUTO_MODEL_MODEL=your-vision-model
# UIAUTO_MODEL_API_KEY=
# UIAUTO_MODEL_MAX_TOKENS=4096
# UIAUTO_MODEL_TIMEOUT=120
# UIAUTO_MODEL_COORDINATE_SPACE=normalized
# Optional planner, enabled per run with --planner.
# UIAUTO_PLANNER_BASE_URL=https://your-reasoning-endpoint/v1
# UIAUTO_PLANNER_MODEL=your-reasoning-model
# UIAUTO_PLANNER_API_KEY=
# UIAUTO_PLANNER_MAX_TOKENS=4096
# UIAUTO_PLANNER_TIMEOUT=120
# Optional screenshot reviewer; falls back to planner, then actor/Holo.
# UIAUTO_KNOWLEDGE_BASE_URL=https://your-vision-reviewer/v1
# UIAUTO_KNOWLEDGE_MODEL=your-review-model
# UIAUTO_KNOWLEDGE_API_KEY=
# Saved starting projects; matrix uses the matching host's project automatically.
# CARLA_PROJECT=/workspaces/LinuxPilot/projects/baseline.carxp
# ARDOUR_PROJECT=/workspaces/LinuxPilot/projects/ardour-baseline/ardour-baseline.ardour
# REAPER_PROJECT=/workspaces/LinuxPilot/projects/baseline.rpp
